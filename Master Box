    cfg["tagline"] = request.form.get("tagline", cfg["tagline"])
    cfg["home_title"] = request.form.get("home_title", cfg["home_title"])
    cfg["home_text"] = request.form.get("home_text", cfg["home_text"])
    cfg["footer_text"] = request.form.get("footer_text", cfg["footer_text"])
    
