function T(n,e){
  document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('on'));
  e.classList.add('on');
  ['v','a','r','p','i'].forEach(x=>document.getElementById('tab-'+x).classList.add('hide'));
  document.getElementById('tab-'+n).classList.remove('hide');
